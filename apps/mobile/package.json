{
  "name": "lav-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:ios:dev": "eas build --profile development --platform ios",
    "build:android:dev": "eas build --profile development --platform android",
    "build:web": "expo export -p web && node scripts/postbuild-web.js",
    "deploy": "pnpm build:web && npx gh-pages -d dist -b gh-pages -t"
  },
  "dependencies": {
    "@expo-google-fonts/eb-garamond": "^0.4.3",
    "@expo/metro-runtime": "56.0.15",
    "@expo/vector-icons": "15.1.1",
    "@maplibre/maplibre-react-native": "11.3.6",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@supabase/supabase-js": "2.108.2",
    "expo": "56.0.12",
    "expo-blur": "56.0.3",
    "expo-constants": "56.0.18",
    "expo-dev-client": "56.0.20",
    "expo-font": "56.0.7",
    "expo-haptics": "56.0.3",
    "expo-image": "56.0.11",
    "expo-image-picker": "56.0.18",
    "expo-linking": "56.0.14",
    "expo-localization": "^57.0.1",
    "expo-location": "56.0.18",
    "expo-router": "56.2.11",
    "expo-splash-screen": "56.0.10",
    "expo-status-bar": "56.0.4",
    "expo-system-ui": "56.0.5",
    "i18next": "^26.3.6",
    "maplibre-gl": "5.24.0",
    "pinyin-match": "^1.2.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "3.0.2",
    "react-native-get-random-values": "2.0.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.0",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "@types/supercluster": "^7.1.3",
    "eas-cli": "^16.31.0",
    "typescript": "~6.0.3"
  }
