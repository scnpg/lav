{
  "expo": {
    "name": "Lav",
    "slug": "lav",
    "scheme": "lav",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDFBF7",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lav.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lav uses your location only when you tap \"Use my location\", to find nearby bathrooms. Lav never stores or shares your live location.",
        "NSPhotoLibraryUsageDescription": "Lav needs access to your photos so you can attach a picture to a bathroom submission or review.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lav.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF7"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lav uses your location only when you tap \"Use my location\", to find nearby bathrooms. Lav never stores or shares your live location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lav needs access to your photos so you can attach a picture to a bathroom submission or review."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "27530bd5-31fe-46f4-80c2-59f1e2c46601"
      }
    },
    "experiments": {
      "baseUrl": "/lav"
    }
  }
}
