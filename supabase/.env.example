# Supabase CLI-level secrets (auto-loaded from supabase/.env by the CLI
# itself - distinct from supabase/functions/.env, which is only for Edge
# Function runtime env vars). Copy this file to supabase/.env and fill in
# real values; supabase/.env is gitignored, never commit real keys.
#
# Used by supabase/config.toml's [auth.email.smtp] section via env(...)
# interpolation - see README "Email setup (Resend SMTP)". Only needed if you
# flip that section's `enabled` to true; local dev works fine without it
# (falls back to [local_smtp]/Mailpit, which never sends real email).

RESEND_API_KEY=
